# Plantilla de configuracion. Copiar a .env y completar con valores reales;
# .env nunca se versiona (ver .gitignore). Estas son las variables que usa
# docker-compose.yml para levantar el Hub (hub/) -- este proyecto es una
# integracion sobre una instalacion de OpenCTI ya desplegada por separado,
# no levanta OpenCTI en si (ver README.md #13).
#
# La autenticacion contra OpenCTI es solo por API key (OPENCTI_SERVICE_ACCOUNT_TOKEN,
# sin usuario/clave separados) -- con eso, la URL, el host publico del Hub y
# (si esta co-ubicado con OpenCTI, la topologia normal de este proyecto) la
# red Docker + verificacion TLS de abajo, alcanza para levantar.

# ---------------------------------------------------------------------
# 1) Obligatorio
# ---------------------------------------------------------------------

# OpenCTI (instancia ya desplegada aparte)
OPENCTI_URL=https://opencti.example.local:8446
# API key de una cuenta de servicio, NUNCA la cuenta administrativa de
# OpenCTI. No hay login usuario/clave: esto es lo unico que autentica.
OPENCTI_SERVICE_ACCOUNT_TOKEN=changeme

# Host/IP donde va a estar disponible este Hub. Se usa para: nombre del
# certificado TLS (./certs/$PUBLIC_HOST.crt/.key), server_name de nginx, y
# origen por defecto habilitado para la UI (ver ADMIN_UI_ORIGINS abajo).
PUBLIC_HOST=hub.example.local

# Puerto HTTPS propio del Hub. OJO: si el Hub esta co-ubicado en el mismo
# host que OpenCTI, el nginx de OpenCTI puede ya estar usando 8446 -- antes
# de levantar, revisar con `docker ps` que el puerto elegido este libre.
NGINX_HTTPS_PORT=8446

# ---------------------------------------------------------------------
# 2) Casi siempre necesario si el Hub esta co-ubicado con OpenCTI
#    (la topologia normal: mismo host, misma red Docker)
# ---------------------------------------------------------------------

# Nombre de la red Docker externa de OpenCTI. NO es "opencti-net" por
# default en todos lados -- confirmarlo con:
#   docker network ls
#   docker network inspect <nombre> --format '{{range .Containers}}{{.Name}} {{end}}'
# (buscar la red donde aparecen los contenedores de OpenCTI, ej. opencti-platform,
# opencti-worker, elasticsearch, rabbitmq -- en despliegues Filigran/XTM suele
# llamarse "xtm_default"). Si OpenCTI es remoto (otro host, sobre HTTPS), esta
# variable no se usa -- ver comentario en docker-compose.yml.
OPENCTI_DOCKER_NETWORK=opencti-net

# La mayoria de los despliegues on-prem de OpenCTI usan un certificado TLS
# autofirmado -- con el default (true) hub-service no arranca (SSLError:
# self-signed certificate in certificate chain). Si es tu caso, poner false.
# Alternativa mas prolija sin desactivar la verificacion: OPENCTI_CA_CERT_PATH
# (ver hub/config.py) apuntando al certificado/CA real, montado en el contenedor.
OPENCTI_TLS_VERIFY=true

# OPENCTI_STREAM_ID=

# ---------------------------------------------------------------------
# 3) Opcional -- los defaults de abajo ya cubren el caso comun
# ---------------------------------------------------------------------

# --- Rutas de host (por defecto: relativas a este repo) ---
# HUB_APP_PATH=.                          # codigo del repo, con hub/
# UI_DIST_PATH=./ui/dist/ui/browser       # salida de `ng build`
# NGINX_CONF_PATH=./nginx.conf
# NGINX_CERTS_PATH=./certs                # certificados $PUBLIC_HOST.crt/.key
# Descomentar y apuntar a otro lado solo si tu despliegue guarda alguna de
# estas carpetas fuera del checkout del repo.

# --- Hub ---
# HUB_SOURCE_ID=opencti-main
# RECONCILE_INTERVAL_SECONDS=600
# Origen habilitado para CORS de la UI Angular. Por defecto se calcula solo
# como https://$PUBLIC_HOST:$NGINX_HTTPS_PORT (mismo origen que sirve nginx,
# por lo que el navegador ni pide CORS). Declarar solo si la UI se sirve
# desde otro origen (por ejemplo, `ng serve` en desarrollo).
# ADMIN_UI_ORIGINS=

# --- OIDC/SSO (opcional; los API tokens locales siguen funcionando sin esto) ---
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET_REF=
# OIDC_REDIRECT_URI=
# OIDC_ROLE_MAPPING={}

# --- Alertas email/webhook (opcional) ---
# ALERT_SMTP_HOST=
# ALERT_SMTP_PORT=25
# ALERT_EMAIL_FROM=
# ALERT_EMAIL_TO=
# ALERT_EMAIL_CREDENTIAL_REF=
# ALERT_WEBHOOK_URL=
# ALERT_WEBHOOK_CREDENTIAL_REF=
# ALERT_COOLDOWN_SECONDS=300

# --- Secret manager: cifrado en reposo (opcional hasta usar credential_ref=secret://) ---
# SECRET_ENCRYPTION_KEY=

# --- Limites de recursos ---
# NGINX_MEM_LIMIT=256m
# NGINX_CPU_LIMIT=0.50
# HUB_SERVICE_MEM_LIMIT=512m
# HUB_SERVICE_CPU_LIMIT=1.0
# HUB_API_MEM_LIMIT=512m
# HUB_API_CPU_LIMIT=1.0

# --- OpenTelemetry (opcional, aditivo -- el Hub funciona igual sin esto) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=
