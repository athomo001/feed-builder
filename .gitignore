# Secretos y configuracion local (AUDITORIA.md P0 - nunca versionar)
.env
.env.*
!.env.example
*.pem
*.key
*.crt

# nginx.conf es la plantilla generica del Hub (usa ${PUBLIC_HOST} /
# ${NGINX_HTTPS_PORT}, resueltos via envsubst al arrancar el contenedor,
# ver docker-compose.yml) -- no trae IP/hostname reales, se versiona.
# Los certificados si son locales y no se versionan (ver *.crt/*.key arriba).

# Estado y salidas en runtime del feed-builder legado
feeds/
state.json
*.heartbeat

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# Hub (Entrega 0+)
hub/**/__pycache__/

# Spec, configuracion local de Claude Code y auditoria interna:
# no se versionan en este repo (contienen datos propios de la empresa).
spec/
.claude/
AUDITORIA.md
tests/