# Plantilla de configuracion (AUDITORIA.md P0). Copiar a .env y completar con
# valores reales; .env nunca se versiona (ver .gitignore).
#
# Las mismas claves que usa docker-compose.yml, con valores ficticios.

MINIO_ROOT_USER=changeme
MINIO_ROOT_PASSWORD=changeme
RABBITMQ_DEFAULT_USER=changeme
RABBITMQ_DEFAULT_PASS=changeme
SMTP_HOSTNAME=localhost
ELASTIC_MEMORY_SIZE=2G
XTM_COMPOSER_ID=00000000-0000-0000-0000-000000000000
COMPOSE_PROJECT_NAME=xtm
OPENCTI_DOCKER_NETWORK=opencti-net
REDIS_MAX_MEMORY=2gb
REDIS_MEM_LIMIT=3g
REDIS_CPU_LIMIT=1.0
OPENCTI_MEM_LIMIT=4g
OPENCTI_CPU_LIMIT=2.0
WORKER_MEM_LIMIT=1g
WORKER_CPU_LIMIT=1.0
NGINX_HTTPS_PORT=8446
PUBLIC_HOST=opencti.example.local
NGINX_CONF_PATH=/opt/opencti/nginx.conf
NGINX_CERTS_PATH=/opt/opencti/certs
NGINX_FEEDS_PATH=/opt/opencti/feeds
NGINX_MEM_LIMIT=256m
NGINX_CPU_LIMIT=0.50
OPENCTI_ADMIN_EMAIL=admin@example.com
OPENCTI_ADMIN_PASSWORD=changeme
OPENCTI_ADMIN_TOKEN=00000000-0000-0000-0000-000000000000
OPENCTI_BASE_URL=https://opencti.example.local:8446
OPENCTI_PORT=8080
OPENCTI_NODE_MAX_OLD_SPACE=2048
OPENCTI_HEALTHCHECK_ACCESS_KEY=changeme
CONNECTOR_EXPORT_FILE_STIX_ID=00000000-0000-0000-0000-000000000001
CONNECTOR_EXPORT_FILE_CSV_ID=00000000-0000-0000-0000-000000000002
CONNECTOR_EXPORT_FILE_TXT_ID=00000000-0000-0000-0000-000000000003
CONNECTOR_IMPORT_FILE_STIX_ID=00000000-0000-0000-0000-000000000004
CONNECTOR_IMPORT_DOCUMENT_ID=00000000-0000-0000-0000-000000000005
CONNECTOR_IMPORT_FILE_YARA_ID=00000000-0000-0000-0000-000000000006
CONNECTOR_IMPORT_EXTERNAL_REFERENCE_ID=00000000-0000-0000-0000-000000000007
CONNECTOR_ANALYSIS_ID=00000000-0000-0000-0000-000000000008
CONNECTOR_MISP_ID=connector-misp
CONNECTOR_MISP_NAME=MISP
CONNECTOR_ABUSEIPDB_ID=00000000-0000-0000-0000-000000000009
CONNECTOR_MALWAREBAZAAR_ID=00000000-0000-0000-0000-00000000000a
CONNECTOR_ALIENVAULT_ID=00000000-0000-0000-0000-00000000000b
CONNECTOR_CISA_KEV_ID=00000000-0000-0000-0000-00000000000c
QRADAR_LIVE_STREAM_ID=00000000-0000-0000-0000-00000000000d
CUSTOM_CA_CERT_FILE=/opt/opencti/certs/your-ca.crt
MALPEDIA_RSS_APP_PATH=/opt/opencti/malpedia-rss
FEED_BUILDER_APP_PATH=/opt/opencti/feed-builder
FEEDS_OUTPUT_PATH=/opt/opencti/feeds
ABUSEIPDB_INTERVAL=7200
MALPEDIA_RSS_FORCE_REPROCESS=false
FEED_BUILDER_WRITE_INTERVAL_SEC=300
FEED_BUILDER_MAX_RECORDS_PER_FEED=20000
FEED_BUILDER_URL_STRIP_SCHEME=true
FEED_BUILDER_URL_KEEP_QUERY=true
FEED_BUILDER_BACKFILL_ENABLED=false
FEED_BUILDER_BACKFILL_MAX_PAGES=10
CONNECTOR_OPENCTI_ID=00000000-0000-0000-0000-00000000000e
CONNECTOR_MITRE_ID=00000000-0000-0000-0000-00000000000f
NEO4J_PASSWORD=changeme
MISP_KEY=changeme
ABUSEIPDB_API_KEY=changeme
ALIENVAULT_API_KEY=changeme
MALWAREBAZAAR_AUTH_KEY=changeme
QRADAR_CONNECTOR_ID=00000000-0000-0000-0000-000000000010
QRADAR_CONNECTOR_NAME=OpenCTI_to_QRadar
QRADAR_URL=https://qradar.example.local
QRADAR_SSL_VERIFY=true
QRADAR_TOKEN=00000000-0000-0000-0000-000000000011
QRADAR_REFERENCE_NAME=OpenCTI
QRADAR_IGNORE_TYPES=label,marking-definition,identity

# Healthcheck del feed-builder legado (ver AUDITORIA.md P2 y opencti_feed_builder.py)
