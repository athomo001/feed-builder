events {
    worker_connections 1024;
}

http {
    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    # Redirigir HTTP a HTTPS (Opcional, pero recomendado)
    server {
        listen 80;
        server_name your-server-ip-or-hostname;
        return 301 https://$host:8446$request_uri;
    }

    server {
        # Escuchamos en el puerto 443 (SSL) DENTRO del contenedor
        listen 443 ssl;
        server_name your-server-ip-or-hostname;

        # Rutas DENTRO del contenedor (mapeadas desde /opt/opencti/certs)
        ssl_certificate /etc/nginx/certs/your-server.crt;
        ssl_certificate_key /etc/nginx/certs/your-server.key;

        # Configuración estándar de seguridad
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers HIGH:!aNULL:!MD5;

        # Aumentar límite de subida para OpenCTI
        client_max_body_size 500M;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        send_timeout 3600s;

        # =========================================================
        # FEEDS TXT (Fortinet / FW) -> /feeds/ip.txt, /feeds/url.txt, /feeds/hash.txt
        # Requiere que montes /opt/opencti/feeds en /usr/share/nginx/html/feeds (RO)
        # =========================================================
        location ^~ /feeds/ {
            root /usr/share/nginx/html;
            default_type text/plain;
            charset utf-8;
            add_header Cache-Control "no-cache";
            # AUDITORIA.md P2: autoindex on revelaba nombres/tamanos de archivo
            # en /feeds/. Solo se sirven los 3 archivos esperados; el resto 404.
            autoindex off;
            try_files $uri =404;
        }

        location / {
            # Redirige el tráfico al contenedor "opencti" puerto 8080
            proxy_pass http://opencti:8080;

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;

            # Necesario para WebSockets (Live streams de OpenCTI)
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
        }

        # Stream SSE de OpenCTI (sin buffering para tiempo real)
        location ^~ /stream/ {
            proxy_pass http://opencti:8080;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Connection "";
            proxy_buffering off;
            proxy_cache off;
            chunked_transfer_encoding off;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }
    }
}
